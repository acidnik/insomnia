# User unit: insomnia runs inside your own systemd user manager, so there is
# no User=/HOME= to keep in sync — %h is your home and config, checks and
# state stay where they already live.
#
# A user manager is stopped when your last session ends, which would kill the
# daemon on logout. Enable lingering once to make the manager (and the unit)
# survive logout and start on boot:
#   loginctl enable-linger $USER
#
# Install:
#   cargo install --path .                      # binary to ~/.cargo/bin
#   mkdir -p ~/.config/systemd/user
#   cp insomnia.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now insomnia
#   journalctl --user -u insomnia -f

[Unit]
Description=insomnia — file-based monitoring daemon
After=network-online.target
Wants=network-online.target

[Service]
# verbose run details (stdout/stderr/exit code/duration) in the journal;
# change to info for a quieter log
Environment=RUST_LOG=debug
ExecStart=%h/.cargo/bin/insomnia %h/.config/insomnia/config.toml
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
